generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum JewelleryKind {
  EARRINGS
  NECKLACE
  RINGS
  BANGLES
  NOSE_RING
  BRACELET
  PENDANT
  MANGALSUTRA
  SUNGLASSES
  WATCH
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  IMAGE_OVERLAY
  MODEL_GLB
  MODEL_GLTF
  ALPHA_MASK
}

enum TryOnSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  ERROR
}

enum CaptureStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  tryOnSessions   TryOnSession[]
  capturedImages  CapturedImage[]
  assignedRoles   UserRole[]     @relation("AssignedBy")
  productsCreated Product[]      @relation("ProductCreatedBy")
  productsUpdated Product[]      @relation("ProductUpdatedBy")
  settingsUpdated Setting[]      @relation("SettingUpdatedBy")
  auditLogs       AuditLog[]

  @@unique([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       UserRole[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([slug])
  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id            String         @id @default(uuid()) @db.Uuid
  categoryId    String         @db.Uuid
  sku           String
  name          String
  slug          String
  description   String?
  jewelleryKind JewelleryKind
  status        ProductStatus  @default(DRAFT)
  priceCents    Int?
  currency      String?        @db.Char(3)
  metadata      Json?
  publishedAt   DateTime?
  createdById   String?        @db.Uuid
  updatedById   String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  category       Category         @relation(fields: [categoryId], references: [id])
  createdBy      User?            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?            @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  images         ProductImage[]
  jewelleryAssets JewelleryAsset[]
  tryOnSessions  TryOnSession[]
  capturedImages CapturedImage[]

  @@unique([slug])
  @@unique([sku])
  @@index([categoryId])
  @@index([jewelleryKind])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @db.Uuid
  storageKey String
  url        String
  altText    String?
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, sortOrder])
  @@index([deletedAt])
  @@map("product_images")
}

model JewelleryAsset {
  id                   String        @id @default(uuid()) @db.Uuid
  productId            String        @db.Uuid
  kind                 JewelleryKind
  assetType            AssetType
  storageKey           String
  url                  String
  anchorProfile        Json
  defaultScale         Float         @default(1)
  defaultRotationZ     Float         @default(0)
  mirrorForOppositeEar Boolean       @default(false)
  fingerIndex          Int?
  version              Int           @default(1)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, isActive])
  @@index([kind])
  @@index([deletedAt])
  @@map("jewellery_assets")
}

model TryOnSession {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String?            @db.Uuid
  productId     String             @db.Uuid
  jewelleryKind JewelleryKind
  status        TryOnSessionStatus @default(ACTIVE)
  clientInfo    Json?
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  metrics       Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  user           User?           @relation(fields: [userId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  capturedImages CapturedImage[]

  @@index([userId, createdAt])
  @@index([productId])
  @@index([status])
  @@index([deletedAt])
  @@map("try_on_sessions")
}

model CapturedImage {
  id              String        @id @default(uuid()) @db.Uuid
  sessionId       String        @db.Uuid
  userId          String?       @db.Uuid
  productId       String        @db.Uuid
  storageKey      String
  url             String
  thumbStorageKey String?
  width           Int?
  height          Int?
  mimeType        String
  fileSizeBytes   Int?
  status          CaptureStatus @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  session TryOnSession @relation(fields: [sessionId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])
  product Product      @relation(fields: [productId], references: [id])

  @@index([sessionId])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("captured_images")
}

model Setting {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  value       Json
  valueType   SettingValueType
  description String?
  isPublic    Boolean          @default(false)
  updatedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([isPublic])
  @@index([deletedAt])
  @@map("settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
