NODE_ENV=development

# API
API_PORT=4000
DATABASE_URL=postgresql://vj:vjsecret@localhost:5432/vj_tryon?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage (minio | r2)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=vj-assets
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/vj-assets
STORAGE_FORCE_PATH_STYLE=true
PRESIGN_UPLOAD_TTL_SEC=600
PRESIGN_DOWNLOAD_TTL_SEC=120
CAPTURES_DEFAULT_TTL_DAYS=30

# Web / Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
